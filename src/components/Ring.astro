---
/**
 * Residual's mark: the app icon's ring, in three parts. Ported from residual.fit's Ring.astro with the app's
 * light-theme colors baked in. Solid green is what's eaten, three ghost dots are what's still planned, and the
 * dot is where the day lands; the open stretch after it is the residual (2026-11-13, with the app icon).
 */
interface Props {
  size?: string;
  eaten?: number;
  lands?: number;
  width?: number;
  class?: string;
}
const { size = '1em', eaten = 0.6, lands = 0.875, width = 0.16, class: cls = '' } = Astro.props;
const c = 50,
  r = 30,
  w = width * 100;
const planFrom = 0.655,
  planTo = 0.835,
  planDots = 3;
const pt = (f: number) => {
  const a = f * 2 * Math.PI - Math.PI / 2;
  return [c + r * Math.cos(a), c + r * Math.sin(a)];
};
const arc = (from: number, to: number) => {
  const [x1, y1] = pt(from),
    [x2, y2] = pt(Math.min(to, from + 0.9999));
  return `M ${x1.toFixed(3)} ${y1.toFixed(3)} A ${r} ${r} 0 ${to - from > 0.5 ? 1 : 0} 1 ${x2.toFixed(3)} ${y2.toFixed(3)}`;
};
const dots = Array.from({ length: planDots }, (_, i) => pt(planFrom + ((planTo - planFrom) * (i + 0.5)) / planDots));
const [lx, ly] = pt(lands);
const eatenColor = '#057836';
const plan = 'rgb(5 120 54 / 0.30)';
---

<svg class={cls} viewBox="0 0 100 100" style={`width:${size};height:${size}`} aria-hidden="true">
  <path d={arc(0, eaten)} fill="none" stroke={eatenColor} stroke-width={w} stroke-linecap="round"></path>
  {dots.map(([x, y]) => <circle cx={x.toFixed(3)} cy={y.toFixed(3)} r={w * 0.2} fill={plan} />)}
  <circle cx={lx.toFixed(3)} cy={ly.toFixed(3)} r={w / 2} fill={eatenColor}></circle>
</svg>
