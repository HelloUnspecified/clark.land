---
/**
 * clark.land: Clark's link page and virtual business card ("you can get to all my stuff at clark.land").
 * In order: who he is (portrait, name, bio, socials), Residual, Troth, how to reach him, kind words.
 * One narrow column at every width, like a card. Spacing scale: 8 and 16 inside a group, 24 inside a card
 * and as the gutter, 48 between groups, 96 between sections.
 */
import { getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Ring from '../components/Ring.astro';
import TrothSignup from '../components/TrothSignup.astro';
import SocialIcon from '../components/SocialIcon.astro';
import portrait from '../assets/clark.webp';

const entry = await getEntry('profile', 'clark');
if (!entry) throw new Error('Missing src/content/profile/clark.mdx');
const p = entry.data;

const site = Astro.site!.href;
const title = `${p.name} · Residual, Troth and how to reach me`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: site,
  mainEntity: {
    '@type': 'Person',
    name: p.name,
    jobTitle: 'Founder',
    description: p.description,
    image: new URL('/og.png', site).href,
    email: `mailto:${p.email}`,
    address: { '@type': 'PostalAddress', addressLocality: 'Spring Grove', addressRegion: 'IL', addressCountry: 'US' },
    worksFor: { '@type': 'Organization', name: 'Unspecified Software Co.', url: 'https://unspecified.io' },
    sameAs: [...p.socials.map((s) => s.href), 'https://unspecified.io'],
    owns: [
      { '@type': 'SoftwareApplication', name: 'Residual', operatingSystem: 'iOS', applicationCategory: 'HealthApplication', url: 'https://residual.fit' },
      { '@type': 'SoftwareApplication', name: 'Troth', operatingSystem: 'iOS', applicationCategory: 'LifestyleApplication', url: 'https://jointroth.co' },
    ],
  },
};

const year = new Date().getFullYear();
const external = (href: string) => /^https?:/.test(href);
const head = 'font-heading text-head font-semibold tracking-[-0.02em]';
const small = 'inline-block py-2 text-small font-semibold text-soft underline decoration-soft/40 underline-offset-4 transition-colors hover:text-ink hover:decoration-ink';
---

<Layout title={title} description={p.description} keywords={p.keywords} jsonLd={jsonLd}>
  <main class="mx-auto w-full max-w-[608px] overflow-x-clip px-6">
    <!-- ───────── Who: portrait, name, bio, socials. ───────── -->
    <header class="pt-[max(1.5rem,env(safe-area-inset-top))] sm:pt-16">
      <div class="arrive flex items-center gap-4" style="--i:0">
        <Image src={portrait} alt="Clark Sell" widths={[160, 320]} sizes="80px" loading="eager" fetchpriority="high" class="size-20 shrink-0 object-cover object-[50%_32%]" />
        <div class="min-w-0">
          <h1 class="font-heading text-[2.5rem] leading-none font-bold tracking-[-0.035em]">{p.name}</h1>
          <p class="mt-1 text-small text-soft">{p.byline}</p>
        </div>
      </div>
      <p class="arrive mt-6 font-heading text-lead leading-[1.2] font-semibold tracking-[-0.015em] text-balance" style="--i:1">{p.lead}</p>
      <p class="arrive mt-2 text-body text-ink" style="--i:2">{p.bio}</p>
      <ul class="arrive mt-2 -ml-2.5 flex flex-wrap" style="--i:3" aria-label="Clark elsewhere">
        {
          p.socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="me noopener noreferrer"
                data-track={`Social: ${s.title}`}
                aria-label={s.title}
                title={s.title}
                class="flex size-11 items-center justify-center text-soft transition-[color,transform] duration-150 ease-[var(--ease-out)] hover:text-ink active:scale-90"
              >
                <SocialIcon name={s.icon} class="size-6" />
              </a>
            </li>
          ))
        }
      </ul>
    </header>

    <!-- ───────── The two apps. ───────── -->
    <section class="mt-6 grid gap-2" aria-label="Our apps">
      <article class="arrive bg-surface p-6" style="--i:4">
        <div class="flex items-center justify-between gap-4">
          <a href={p.residual.site} target="_blank" rel="noopener noreferrer" data-track="Residual: name" class="group flex items-center gap-2">
            <Ring size="1.4rem" />
            <h2 class:list={[head, 'leading-none group-hover:underline group-hover:underline-offset-4']}>Residual</h2>
          </a>
          <span class="text-small text-soft">{p.residual.status}</span>
        </div>
        <p class="mt-2 text-body text-ink">{p.residual.line}</p>
        <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-2">
          <a href={p.residual.appStore} target="_blank" rel="noopener noreferrer" data-track="Residual: App Store" class="inline-block transition-transform duration-150 ease-[var(--ease-out)] active:scale-[0.96]">
            <img src="/app-store/download-black.svg" alt="Download Residual on the App Store" width="144" height="48" class="block h-12 w-auto" />
          </a>
          {p.residual.more.map((l) => <a href={l.href} target="_blank" rel="noopener noreferrer" data-track={`Residual: ${l.title}`} class={small}>{l.title}</a>)}
        </div>
      </article>

      <article class="arrive bg-surface p-6" style="--i:5" id="troth">
        <div class="flex items-center justify-between gap-4">
          <a href={p.troth.site} target="_blank" rel="noopener noreferrer" data-track="Troth: name" class="group flex items-center gap-2">
            <svg width="28" height="18" viewBox="0 0 64 40" fill="none" aria-hidden="true">
              <path d="M18.5 6.2c4.1 0 7 6.4 7 14.1 0 7.7-2.9 13.9-7 13.9s-7-6.2-7-13.9c0-7.7 2.9-14.1 7-14.1Z" fill="#C2664D"></path>
              <path d="M39.5 6.2c4.1 0 7 6.4 7 14.1 0 7.7-2.9 13.9-7 13.9s-7-6.2-7-13.9c0-7.7 2.9-14.1 7-14.1Z" fill="#9A4352"></path>
            </svg>
            <h2 class:list={[head, 'leading-none group-hover:underline group-hover:underline-offset-4']}>Troth</h2>
          </a>
          <span class="text-small text-soft">{p.troth.status}</span>
        </div>
        <p class="mt-2 text-body text-ink">{p.troth.line}</p>
        <div class="mt-4">
          <TrothSignup site={p.troth.site} />
        </div>
        <ul class="mt-2 flex flex-wrap gap-x-6">
          {p.troth.more.map((l) => <li><a href={l.href} target="_blank" rel="noopener noreferrer" data-track={`Troth: ${l.title}`} class={small}>{l.title}</a></li>)}
        </ul>
      </article>
    </section>

    <!-- ───────── How to reach me. ───────── -->
    <section class="mt-24" aria-labelledby="hello">
      <h2 id="hello" class={head} data-in>Say hello</h2>
      <p class="mt-2 text-body text-soft" data-in style="--i:1">{p.contact.sentence}</p>
      <a
        href={`mailto:${p.email}`}
        data-track="Contact: email"
        class="group mt-6 flex items-center justify-between gap-4 bg-ink p-6 text-ground transition-transform duration-150 ease-[var(--ease-out)] active:scale-[0.985]"
        data-in
        style="--i:2"
      >
        <span class="text-lead font-semibold break-all">{p.email}</span>
        <svg class="size-6 shrink-0 transition-transform duration-200 ease-[var(--ease-out)] group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
          <path d="M4 12h15M13 6l6 6-6 6"></path>
        </svg>
      </a>
      <a href={p.contact.speaking} data-track="Contact: speaking" class="mt-4 inline-block py-2 text-body text-ink underline decoration-soft underline-offset-4 hover:decoration-ink" data-in style="--i:3">
        Ask me to speak at your event
      </a>
    </section>

    <!-- ───────── Kind words, from across everything we do. Verbatim. ───────── -->
    <section class="mt-24" aria-labelledby="words">
      <h2 id="words" class={head} data-in>Kind words</h2>
      <div class="mt-6 grid gap-12">
        {
          p.testimonials.map((t, i) => (
            <figure data-in style={`--i:${i}`}>
              <blockquote class="text-body text-ink">“{t.quote}”</blockquote>
              <figcaption class="mt-4 flex items-center gap-4">
                <img src={t.image} alt="" width="48" height="48" loading="lazy" decoding="async" class="size-12 shrink-0 object-cover" />
                <span class="leading-tight">
                  <span class="block font-semibold text-ink">{t.name}</span>
                  <span class="block text-small text-soft">{t.role}</span>
                </span>
              </figcaption>
            </figure>
          ))
        }
      </div>
    </section>

    <footer class="mt-24 flex flex-wrap items-center justify-between gap-x-6 gap-y-4 pb-[max(3rem,env(safe-area-inset-bottom))]">
      <a href="https://unspecified.io/?utm_source=clark.land&utm_medium=referral" target="_blank" rel="noopener noreferrer" data-track="Footer: Unspecified" class="transition-opacity hover:opacity-80">
        <img src="/brand/unspecified-logo.svg" alt="Unspecified Software Co." width="3185" height="1015" loading="lazy" class="h-10 w-auto" />
      </a>
      <p class="text-small text-soft">© {year} · {p.location}</p>
    </footer>
  </main>
</Layout>
